{
  "expo": {
    "name": "BicaraPro",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bicarapro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.intonationdetector.vqfnst",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Rekam suara untuk analisis MFCC public speaking"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D9488"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.intonationdetector.vqfnst",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D9488"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rekam suara untuk analisis MFCC public speaking"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}